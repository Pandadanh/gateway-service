# ============================================
# GATEWAY SERVICE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update with your values

# ---------------------------------------------
# APPLICATION
# ---------------------------------------------
NODE_ENV=development

# ---------------------------------------------
# GATEWAY SERVER
# ---------------------------------------------
GATEWAY_PORT=8080
GATEWAY_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------
# CORS
# ---------------------------------------------
# Comma-separated origins or * for all
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# ---------------------------------------------
# JWT AUTHENTICATION
# ---------------------------------------------
# Set to true to enable JWT validation in gateway
JWT_ENABLED=false
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ---------------------------------------------
# RATE LIMITING
# ---------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_CLEANUP_PROBABILITY=0.01

# ---------------------------------------------
# PROXY CONFIGURATION
# ---------------------------------------------
# Timeout in milliseconds (default: 30 minutes for large uploads)
PROXY_TIMEOUT_MS=1800000
PROXY_UPLOAD_TIMEOUT_MS=1800000
PROXY_SLOW_REQUEST_THRESHOLD_MS=5000
PROXY_INVALID_SERVICE_URL=http://127.0.0.1:9

# Follow-redirects max body length (default: 2GB)
FOLLOW_REDIRECTS_MAX_BODY_LENGTH=2147483648

# ---------------------------------------------
# SERVICE REGISTRY
# ---------------------------------------------
REGISTRY_HEALTH_CHECK_INTERVAL=10000
REGISTRY_INSTANCE_TTL=30000
REGISTRY_HEALTH_CHECK_TIMEOUT_MS=5000
REGISTRY_HEALTH_CHECK_ENDPOINT=/api/health

# ---------------------------------------------
# LOGGING
# ---------------------------------------------
LOG_LEVEL=info
LOG_SLOW_REQUEST_THRESHOLD_MS=1000
LOG_ERROR_THRESHOLD=400

# ---------------------------------------------
# REDIS (Optional - for distributed registry)
# ---------------------------------------------
REDIS_URL=redis://localhost:6379
